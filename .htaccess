# Open index.html first (before any index.php / default.php)
DirectoryIndex index.html index.php default.php

# Send every visitor to one address: https://keithnah.com
RewriteEngine On
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^(.*)$ https://keithnah.com/$1 [L,R=301]

# Keep helper scripts in /tools private (they are for setup, not for visitors)
RedirectMatch 404 ^/tools(/|$)
RedirectMatch 404 ^/CLAUDE\.md$

# Friendly "page not found" page
ErrorDocument 404 /404.html

# Security headers: HTTPS only, no framing by other sites, no content-type guessing
<IfModule mod_headers.c>
Header always set Strict-Transport-Security "max-age=31536000"
Header always set X-Content-Type-Options "nosniff"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
</IfModule>

# Browsers keep scripts and styles for a day (data files also change their ?v= address with each build)
<IfModule mod_headers.c>
# Pages: always check for a newer version, so visitors see updates straight away
<FilesMatch "\.html$">
Header set Cache-Control "no-cache"
</FilesMatch>
<FilesMatch "\.(js|css)$">
Header set Cache-Control "public, max-age=86400"
</FilesMatch>
</IfModule>

# Removed projects (410 Gone)
Redirect gone /property/lightwater-residence.html
Redirect gone /zh/property/lightwater-residence.html
Redirect gone /zh-tw/property/lightwater-residence.html
Redirect gone /ms/property/lightwater-residence.html
Redirect gone /ja/property/lightwater-residence.html
Redirect gone /ko/property/lightwater-residence.html
